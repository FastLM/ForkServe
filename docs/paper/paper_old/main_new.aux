\newlabel{fig:radix}{{5}{8}{\textbf {One radix tree, five actions} (\eqref {eq:action}--\eqref {eq:xfer}). The root is the aliased trunk $x_u$. Each edge is one page of $P$ tokens. Green pages are in $H$; orange pages are prefilled; gray pages are withheld. (a)~$\mathrm {HS}$: $m_i{=}\ell _i$, $\Work _i{=}\Xfer _i{=}0$. (b)~$\mathrm {HP}$: $0{<}m_i{<}\ell _i$, $\Work _i{=}\ell _i{-}m_i$. (c)~$\mathrm {EA}$: $m_i{=}0$, $F_i{=}1$, $\Work _i{=}\lceil \alpha \ell _i\rceil $, $\Xfer _i{=}0$. (d)~$\mathrm {PF}$: $m_i{=}0$, $i{\notin }\Lambda $, $\neg F_i$, $\Work _i{=}\ell _i$. (e)~$\mathrm {DS}$: $i{\in }\Lambda $, $\Work _i{=}\Xfer _i{=}0$. A low score with $i{\notin }\Lambda $ is not (e); it is prefilled and probed (\Cref {alg:app})}{figure.5}{}}
\newlabel{fig:radix@cref}{{[figure][5][]5}{[1][4][]8}{}{}{}}
\newlabel{tab:app}{{5}{8}{Control-plane fan-out ($10$ sessions, $k{=}4$, $L{=}256$, $\ell {=}32$). Bottleneck in red; ForkServe+ in green. Not GPU wall-clock}{table.5}{}}
