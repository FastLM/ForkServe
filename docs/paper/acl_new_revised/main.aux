\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Context tree.} (a)~Each edge is one \texttt  {fork}: the child aliases the parent and allocates only a residual ($+$r). Live paths share the trunk; A1b1x and A3a2x also share $+$r$_A$. All descendants of fork C are aborted at depth 2, so reclamation propagates up to C and stops at the root, which retains the live children A and B. (b)~A shared layer is one physical page set with reference count greater than one; aborting a leaf frees only its residual.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:tree}{{2}{6}{\textbf {Context tree.} (a)~Each edge is one \texttt {fork}: the child aliases the parent and allocates only a residual ($+$r). Live paths share the trunk; A1b1x and A3a2x also share $+$r$_A$. All descendants of fork C are aborted at depth 2, so reclamation propagates up to C and stops at the root, which retains the live children A and B. (b)~A shared layer is one physical page set with reference count greater than one; aborting a leaf frees only its residual}{figure.caption.7}{}}
\newlabel{fig:tree@cref}{{[figure][2][]2}{[1][5][]6}{}{}{}}
