\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {\textsf  {PD-Prune}\xspace  {} design.} (1)~CoW state: $\sigma _u$ aliases one trunk, \texttt  {fork} is $O(1)$ in $L$, and LCP commit publishes $x_\star $. (2)~Controller policy $\pi $: observation $o_i{=}(m_i^{\ensuremath  {\mathcal  {P}}},m_i^{\ensuremath  {\mathcal  {D}}},s_i)$ maps to $a_i\in \{\textsc  {Hit},\textsc  {Admit},\textsc  {Probe},\textsc  {Reject}\}$; only $\mathcal  {A}$ enters the GPU path. (3)~Disaggregated execution: $\ensuremath  {\mathcal  {P}}$ prefills the miss of $\mathcal  {A}$, the connector ships decoder-missing pages, and $\ensuremath  {\mathcal  {D}}$ runs the $t_0$ probe then the host pruner before LCP commit. Bottom: $M_{\mathrm  {spine}}$ frees HBM and raises analytical session capacity.}}{15}{figure.caption.32}\protected@file@percent }
\newlabel{fig:arch-detail}{{7}{15}{\textbf {\sys {} design.} (1)~CoW state: $\sigma _u$ aliases one trunk, \texttt {fork} is $O(1)$ in $L$, and LCP commit publishes $x_\star $. (2)~Controller policy $\pi $: observation $o_i{=}(m_i^{\Pin },m_i^{\Din },s_i)$ maps to $a_i\in \{\Hit ,\Admit ,\Probe ,\Reject \}$; only $\Act $ enters the GPU path. (3)~Disaggregated execution: $\Pin $ prefills the miss of $\Act $, the connector ships decoder-missing pages, and $\Din $ runs the $t_0$ probe then the host pruner before LCP commit. Bottom: $M_{\mathrm {spine}}$ frees HBM and raises analytical session capacity}{figure.caption.32}{}}
\newlabel{fig:arch-detail@cref}{{[figure][7][]7}{[1][12][]15}{}{}{}}
