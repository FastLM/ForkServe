\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Context-tree page pool} (pruning-aware KV state). \texttt  {fork} aliases the parent page table without copying the trunk KV and allocates only residual pages~\textcircled {1}--\textcircled {3}. LCP commit publishes full blocks of $x_\star $ into $H$ so a later request whose parent-aware prefix is already resident on $\ensuremath  {\mathcal  {D}}$ may take \textsc  {Hit}~\textcircled {4}\textcircled {6}. \texttt  {abort} returns residual pages only; the live occupancy is $M_{\mathrm  {spine}}{=}b(L{+}\ell _\star )$~\textcircled {5}\textcircled {7}.}}{14}{figure.caption.29}\protected@file@percent }
\newlabel{fig:pool}{{4}{14}{\textbf {Context-tree page pool} (pruning-aware KV state). \texttt {fork} aliases the parent page table without copying the trunk KV and allocates only residual pages~\textcircled {1}--\textcircled {3}. LCP commit publishes full blocks of $x_\star $ into $H$ so a later request whose parent-aware prefix is already resident on $\Din $ may take \Hit ~\textcircled {4}\textcircled {6}. \texttt {abort} returns residual pages only; the live occupancy is $M_{\mathrm {spine}}{=}b(L{+}\ell _\star )$~\textcircled {5}\textcircled {7}}{figure.caption.29}{}}
