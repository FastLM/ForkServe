\newlabel{fig:app}{{3}{6}{\textbf {Cost-ordered prefill pruning and transfer gating.} (a)~A residual exits at the first decisive stage: block-hash probe ($\otimes $), draft score ($\oplus $), kernel prefix ($\rhd $), then the GPU miss tail. Only a kept miss tail reaches \texttt {insert}. (b)~APC and stock P/D clone the trunk $k$ ways on the first expand; CoW aliases $L$; \app {} also rejects non-winner $\Work $ and $\Xfer $ before a kernel or a connector write}{figure.3}{}}
\newlabel{fig:app@cref}{{[figure][3][]3}{[1][4][]6}{}{}{}}
\newlabel{tab:span}{{3}{6}{Work, transfer, and memory spans (bottleneck in \textcolor {fsred}{red}). $W_{\mathrm {pre}}$ is GPU prefill tokens; $X$ is connector tokens; $M$ is live KV after abort; $T_{\mathrm {ab}}$ is abort cost in pages; replay is a later \texttt {open} of the published winner. $\mathrm {PAR}$ is the number of trunk copies touched on the first expand}{table.3}{}}
\newlabel{tab:span@cref}{{[table][3][]3}{[1][5][]6}{}{}{}}
