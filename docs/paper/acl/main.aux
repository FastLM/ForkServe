\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Qwen3-8B. (a)~GSM8K controlled mix, $k{=}16$, $n{=}16$, $D{=}512$. Each group is one host. The gray bar is the host alone, blue adds $\tau _{\mathrm  {pre}}$, and green sets the prefill bar to $\tau _{\mathrm  {dec}}$. Any-finished accuracy holds on every bar. At the higher prefill bar the three hosts meet. (b)~MATH-500, $n{=}32$, $D{=}1024$. Each polyline connects $k{=}4$, $k{=}8$, and $k{=}16$. Discarding residuals below $\tau _{\mathrm  {dec}}$ before prefill is fast and less accurate. The probe under $(\tau _{\mathrm  {pre}}, \tau _{\mathrm  {dec}})$ meets the full fan-out at $k{=}16$.}}{8}{figure.caption.15}\protected@file@percent }
\newlabel{fig:results}{{3}{8}{Qwen3-8B. (a)~GSM8K controlled mix, $k{=}16$, $n{=}16$, $D{=}512$. Each group is one host. The gray bar is the host alone, blue adds $\tau _{\mathrm {pre}}$, and green sets the prefill bar to $\tau _{\mathrm {dec}}$. Any-finished accuracy holds on every bar. At the higher prefill bar the three hosts meet. (b)~MATH-500, $n{=}32$, $D{=}1024$. Each polyline connects $k{=}4$, $k{=}8$, and $k{=}16$. Discarding residuals below $\tau _{\mathrm {dec}}$ before prefill is fast and less accurate. The probe under $(\tau _{\mathrm {pre}}, \tau _{\mathrm {dec}})$ meets the full fan-out at $k{=}16$}{figure.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Ablation at $k{=}16$ on the GSM8K controlled mix. ``Cut later'' is the number of admitted residuals the host stops at its own horizon. Any-finished is unchanged. Winner accuracy moves by at most two problems. When the prefill bar is $\tau _{\mathrm  {dec}}$, the host cut fires on nobody and the decode columns meet.}}{8}{table.caption.16}\protected@file@percent }
\newlabel{tab:ablation}{{2}{8}{Ablation at $k{=}16$ on the GSM8K controlled mix. ``Cut later'' is the number of admitted residuals the host stops at its own horizon. Any-finished is unchanged. Winner accuracy moves by at most two problems. When the prefill bar is $\tau _{\mathrm {dec}}$, the host cut fires on nobody and the decode columns meet}{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces MATH-500, Qwen3-8B, $n{=}32$, $D{=}1024$. Each cell is any-finished accuracy and end-to-end time. At $k{=}16$ the probe matches the full fan-out and is $31\%$ faster. At $k{=}4$ and $k{=}8$ it does not fully recover accuracy.}}{8}{table.caption.17}\protected@file@percent }
\newlabel{tab:probe}{{3}{8}{MATH-500, Qwen3-8B, $n{=}32$, $D{=}1024$. Each cell is any-finished accuracy and end-to-end time. At $k{=}16$ the probe matches the full fan-out and is $31\%$ faster. At $k{=}4$ and $k{=}8$ it does not fully recover accuracy}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Winner-only admission on the GSM8K mix. A single reserved slot drops any-finished accuracy on both hosts. Scoring, and keeping the whole live half, restores $16/16$.}}{8}{table.caption.18}\protected@file@percent }
\newlabel{tab:best}{{4}{8}{Winner-only admission on the GSM8K mix. A single reserved slot drops any-finished accuracy on both hosts. Scoring, and keeping the whole live half, restores $16/16$}{table.caption.18}{}}
