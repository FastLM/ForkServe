\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Peak KV on six models ($n{=}40$, $\mathrm  {tp}{=}2$). Each panel is one family; groups are GSM8K and Game24. Bars are recompute, APC, the unpruned spine, and \mbox  {\textsc  {PD-Prune}}\xspace  . \mbox  {\textsc  {PD-Prune}}\xspace  shares the spine with the unpruned runtime, so the two right-hand bars match. The annotated ratio is spine over APC.}}{15}{figure.caption.35}\protected@file@percent }
\newlabel{fig:eval-multi}{{4}{15}{Peak KV on six models ($n{=}40$, $\mathrm {tp}{=}2$). Each panel is one family; groups are GSM8K and Game24. Bars are recompute, APC, the unpruned spine, and \sys . \sys shares the spine with the unpruned runtime, so the two right-hand bars match. The annotated ratio is spine over APC}{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Four systems on Qwen3-8B ($n{=}80$, $\mathrm  {tp}{=}2$, $D{=}512$). Each panel has its own axis. Quality is higher-better; peak KV and end-to-end time are measured values, so a shorter bar is better. (a)~GSM8K. (b)~Game24. \mbox  {\textsc  {PD-Prune}}\xspace  lowers peak KV below APC on both workloads. GSM8K quality stays with APC, and \mbox  {\textsc  {PD-Prune}}\xspace  also lowers GSM8K end-to-end time.}}{15}{figure.caption.36}\protected@file@percent }
\newlabel{fig:eval-radar}{{5}{15}{Four systems on Qwen3-8B ($n{=}80$, $\mathrm {tp}{=}2$, $D{=}512$). Each panel has its own axis. Quality is higher-better; peak KV and end-to-end time are measured values, so a shorter bar is better. (a)~GSM8K. (b)~Game24. \sys lowers peak KV below APC on both workloads. GSM8K quality stays with APC, and \sys also lowers GSM8K end-to-end time}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Offered-load sweep from the measured DeepSeek-R1 GSM8K peaks. Left: saturated tokens per second plateau at concurrency times the decode rate. Right: APC crosses the $1$\,s P99 line first; \mbox  {\textsc  {PD-Prune}}\xspace  stays under it at a higher QPS.}}{16}{figure.caption.37}\protected@file@percent }
