\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {\textsf  {PD-Prune}\xspace  {} runtime architecture.} Requests enter a controller and then a Prefill Pruner (radix prune $a_i$) or a Decoding Pruner (probe $t_0$) before the corresponding instance. Only the miss tail of $\mathcal  {K}$ crosses the KV connector---not the stock $kL+\DOTSB \sum@ \slimits@ _i\ell _i$ payload. Abort retains the spine $M_{\mathrm  {spine}}=b(L+\ell _\star )$.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:system}{{1}{2}{\textbf {\sys {} runtime architecture.} Requests enter a controller and then a Prefill Pruner (radix prune $a_i$) or a Decoding Pruner (probe $t_0$) before the corresponding instance. Only the miss tail of $\Keep $ crosses the KV connector---not the stock $kL+\sum _i\ell _i$ payload. Abort retains the spine $M_{\mathrm {spine}}=b(L+\ell _\star )$}{figure.caption.1}{}}
\newlabel{fig:system@cref}{{[figure][1][]1}{[1][1][]2}{}{}{}}
