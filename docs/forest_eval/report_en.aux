\newlabel{eq:gap}{{5}{4}{Why branch-aware sharing uses less KV than APC}{equation.5}{}}
\newlabel{eq:ratios}{{6}{4}{Why branch-aware sharing uses less KV than APC}{equation.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Storage-efficient serving: what is optimized}{4}{section.5}\protected@file@percent }
