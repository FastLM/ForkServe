\@writefile{toc}{\contentsline {section}{\numberline {2}Experimental settings}{2}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Hardware and engine}{2}{subsection.2.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Hardware and engine. Tensor parallel $\mathrm  {tp}{=}2$ places the model on GPU $0,1$ ($\approx 38497$\,MiB each on Qwen3-14B; $\approx 37305$--$37579$\,MiB each on Qwen3-8B). $\mathrm  {tp}{=}4$ uses GPU $0$--$3$ ($\approx 38797$\,MiB each on Qwen3-14B; $\approx 37599$--$37665$\,MiB each on Qwen3-8B). Peak KV (tokens) is the storage metric; latency scales with $\mathrm  {tp}$.}}{2}{table.caption.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Datasets}{2}{subsection.2.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Datasets. GSM8K: median $43$ words, median $3$ calculation steps, gold extracted at \texttt  {\#\#\#\#}. Game24: $719$ easy / $573$ medium / $70$ hard by published solve rate; success is a valid expression to $24$ (settings E and F use decode $512$ on an $80$-item prefix). HumanEval: median $396$ prompt characters, mean $8.1$ asserts; pass@1 is \texttt  {prompt+body+check}. ReAct idle for wrap+recovery is $2000\,\mathrm  {ms}$. Settings E and F additionally score SVAMP and GSM-Hard with the GSM8K numeric extractor, MATH-500 / AIME / AMC23 with boxed contest answers.}}{2}{table.caption.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Configurations and datasets. Later sections report A--C in full on Qwen3-14B, then E and F on Qwen3-8B (APC vs.\ ForkServe only). On D, recompute and APC are complete; ForkServe on the full Game24 and HumanEval files is in progress.}}{3}{table.caption.4}\protected@file@percent }
