\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Closed forms from \eqref  {eq:rec}--\eqref  {eq:ratios}. Branch-aware sharing matches APC on prefill and is cheaper than recompute by $(1+k\varepsilon )/(k(1+\varepsilon ))$. After abort, $M_{\mathrm  {spine}}$ is the storage-efficient occupancy, below both, which raises $C\propto \mathrm  {HBM}/M$.}}{5}{table.caption.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}GSM8K test set (setting A)}{5}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Resident KV}{5}{subsection.6.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Peak resident KV tokens, GSM8K, $165$ batches of eight problems. Storage efficiency versus recompute is $1-\mathrm  {med}(\mathrm  {peak})/\mathrm  {med}(\mathrm  {peak}^{\mathrm  {rec}})$ on the median.}}{6}{table.caption.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Left: peak KV on each of the $165$ GSM8K batches in the run log (eight problems per batch). Branch-aware abort keeps ForkServe below APC on every batch. Right: ratio $\mathrm  {peak}^{\mathrm  {FS}}/\mathrm  {peak}^{\mathrm  {APC}}$, median $0.72$: $28\%$ less cache than hashed prefix reuse.}}{6}{figure.caption.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Quality}{6}{subsection.6.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}End-to-end latency}{6}{subsection.6.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Left: the storage gap versus APC is a shift of the whole distribution. Right: median peak KV, $0.25\times $ recompute and $0.72\times $ APC.}}{7}{figure.caption.8}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces GSM8K, $n{=}1319$, $k{=}4$, $\mathrm  {tp}{=}2$, eight problems per batch. Storage (peak KV) is the ForkServe gain; accuracy and generate time stay with APC.}}{7}{table.caption.9}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Four-problem slices (settings B and C)}{7}{section.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}GSM8K (settings B and C)}{7}{subsection.7.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Game24 (settings B and C)}{7}{subsection.7.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.3}HumanEval (settings B and C)}{7}{subsection.7.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Storage savings against both vLLM baselines. $S_{\mathrm  {APC}}{=}1-\mathrm  {med}(\mathrm  {peak}^{\mathrm  {FS}})/\mathrm  {med}(\mathrm  {peak}^{\mathrm  {APC}})$. APC already removed most of the cloned-trunk cost ($1430$ vs.\ $4136$). The extra $28\%$ is branch-aware abort: hashed union versus committed path.}}{8}{table.caption.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Official GSM8K extractor, running accuracy. Tree-of-Thoughts accuracy ($\approx 0.845$) is below single-path generation ($\approx 0.941$) because several thoughts compete. The committed path after abort is the same winner decode as APC, so scores stay aligned.}}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:acc}{{3}{8}{Official GSM8K extractor, running accuracy. Tree-of-Thoughts accuracy ($\approx 0.845$) is below single-path generation ($\approx 0.941$) because several thoughts compete. The committed path after abort is the same winner decode as APC, so scores stay aligned}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}Tensor parallel B versus C}{8}{subsection.7.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8}Qwen3-8B math suite (setting E)}{8}{section.8}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Fan-out (ms) per GSM8K batch. The $140$ vs.\ $87$ median is abort and copy-on-write against matched $W$; the storage-efficient claim is peak KV, not this micro-step.}}{9}{table.caption.12}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Generate time on full GSM8K. Decode of $D{=}512$ sets the global $T_{\mathrm  {e2e}}$; ForkServe stays with APC while $M$ is lower, which is storage-efficient serving in \eqref  {eq:conc}.}}{9}{table.caption.13}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}Official scores}{9}{subsection.8.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}Storage and latency}{9}{subsection.8.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3}Four GPUs (setting F)}{9}{subsection.8.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Setting B ($\mathrm  {tp}{=}2$, $n{=}4$). Left: end-to-end time stays with APC ($-0.3\%$, $-0.7\%$, $+0.1\%$) because decode dominates $T_{\mathrm  {e2e}}$. Right: peak resident KV on the same runs. Branch-aware abort compresses storage to $M_{\mathrm  {spine}}$ ($0.70\times $, $0.61\times $, $0.94\times $ APC) at stable latency.}}{10}{figure.caption.14}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces GSM8K, $n{=}4$. FS/APC peak ${=}0.70$; FS/recompute ${=}0.25$: branch-aware sharing is storage-efficient at both $\mathrm  {tp}{=}2$ and $\mathrm  {tp}{=}4$. End-to-end vs.\ APC is $-0.3\%$ at $\mathrm  {tp}{=}2$ and $-0.4\%$ at $\mathrm  {tp}{=}4$.}}{10}{table.caption.15}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {9}Discussion}{10}{section.9}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Game24, $n{=}4$. FS/APC peak ${=}0.61$; FS/recompute ${=}0.26$. A short trunk raises the unused-residual share, so storage-efficient abort saves more versus APC than on GSM8K. End-to-end vs.\ APC is $-0.7\%$ at $\mathrm  {tp}{=}2$ and $-2.0\%$ at $\mathrm  {tp}{=}4$. Success matches on all four problems.}}{11}{table.caption.16}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces HumanEval, $n{=}4$. FS/APC peak ${=}0.94$; FS/recompute ${=}0.49$. ReAct $k{=}2$ with a long observation suffix leaves less unused KV, so the storage gap versus APC is smaller, as \eqref  {eq:gap} predicts. TTFT vs.\ APC is $+0.1\%$ at $\mathrm  {tp}{=}2$ and $+0.4\%$ at $\mathrm  {tp}{=}4$. Pass@1 matches APC ($3/4$).}}{11}{table.caption.17}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {10}Conclusion}{11}{section.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Setting C ($\mathrm  {tp}{=}4$): Game24 and HumanEval. $\mathrm  {peak}^{\mathrm  {FS}}/\mathrm  {peak}^{\mathrm  {APC}}$ is $0.61$ and $0.94$, as in setting B. Those storage ratios are fixed by $k$ and the residuals after abort (\eqref  {eq:gap}). Four-way tensor parallel shards the same committed path, so the HBM advantage versus APC is a property of branch-aware sharing and applies at $\mathrm  {tp}{=}4$.}}{12}{figure.caption.18}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces From $\mathrm  {tp}{=}2$ to $\mathrm  {tp}{=}4$, ForkServe latency (TTFT on HumanEval) scales by $0.61$--$0.63$, in line with decode on twice as many ranks. Peak is the committed-path length $M_{\mathrm  {spine}}$, so the storage ratio to APC is already set by abort in setting B. Four-GPU decode therefore stacks with that storage efficiency: each tree occupies less cache than APC, and $C\propto \mathrm  {HBM}/M$ is larger.}}{12}{table.caption.19}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Setting E, Qwen3-8B, $\mathrm  {tp}{=}2$. ForkServe matches or beats APC on six of seven files. The Game24 gap is one problem on an $80$-item easy prefix ($57$ vs.\ $56$). AIME remains $3/73$ on both stacks: $8$B Tree-of-Thoughts with $D{=}768$ does not solve contest items, so the file is an efficiency check rather than a quality claim.}}{13}{table.caption.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Setting E scores. ForkServe is the right bar in each pair. AIME is near zero on both; the remaining files sit with or above APC.}}{13}{figure.caption.21}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces Setting E storage and generate time. Peak is always $\mathrm  {peak}^{\mathrm  {FS}}<\mathrm  {peak}^{\mathrm  {APC}}$. The lowest ratio is Game24 ($0.62$), where the trunk is short ($L{\approx }72$--$74$), so unused residuals are a larger share of the hashed union, as \eqref  {eq:gap} predicts. AIME is the highest ratio ($0.80$) because the trunk is longer. Generate time stays within $3\%$ of APC; ForkServe fan-out is $0.84$--$1.08\,\mathrm  {s}$ vs.\ APC $0.30$--$0.70\,\mathrm  {s}$, the same abort/CoW micro-gap as on Qwen3-14B.}}{13}{table.caption.22}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Setting E peak KV. Every file is below APC. Game24 shows the largest abort gap; AIME the smallest, still $20\%$ below the hashed union.}}{13}{figure.caption.23}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Setting F, Qwen3-8B, $\mathrm  {tp}{=}4$. Peak KV matches setting E ($1182$, $959$, $1062$, $1349$, $1702$, $1504$, $793$ vs.\ APC $1582$, $1359$, $1462$, $1765$, $2118$, $1920$, $1289$). Official scores stay within three problems of APC. Generate time is within $3\%$ of APC except GSM8K, where ForkServe is $6\%$ faster because winner decode stops earlier ($21369$ vs.\ $40960$ tokens).}}{14}{table.caption.24}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Settings E vs.\ F on ForkServe. Four-way tensor parallel multiplies decode ranks and scales wall-clock by $0.66$ on every file, in line with the $0.61$--$0.63$ factor on Qwen3-14B in setting C. The storage ratio is already fixed by abort in setting E and is unchanged at $\mathrm  {tp}{=}4$.}}{14}{table.caption.25}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Setting E vs.\ setting F, ForkServe only. The left bar of each pair is two GPUs, the right bar four GPUs. Every file scales by $0.66$. Peak KV is omitted: it equals the setting-E figure on every file.}}{14}{figure.caption.26}\protected@file@percent }
