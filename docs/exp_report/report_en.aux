\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Generate time on full GSM8K. Decode of $D{=}512$ sets the global $T_{\mathrm  {e2e}}$; ForkServe stays with APC while $M$ is lower, which is storage-efficient serving in \eqref  {eq:conc}.}}{12}{table.caption.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Setting B ($\mathrm  {tp}{=}2$, $n{=}4$). Left: end-to-end time stays with APC ($-0.3\%$, $-0.7\%$, $+0.1\%$) because decode dominates $T_{\mathrm  {e2e}}$. Right: peak resident KV on the same runs. Branch-aware abort compresses storage to $M_{\mathrm  {spine}}$ ($0.70\times $, $0.61\times $, $0.94\times $ APC) at stable latency.}}{12}{figure.caption.15}\protected@file@percent }
