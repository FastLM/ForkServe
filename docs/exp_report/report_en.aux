\@writefile{toc}{\contentsline {subsection}{\numberline {9.2}System metrics}{6}{subsection.9.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Setting B ($\mathrm  {tp}{=}2$, $n{=}4$). Left: end-to-end time stays with APC ($-0.3\%$, $-0.7\%$, $+0.1\%$) because decode dominates $T_{\mathrm  {e2e}}$. Right: peak resident KV on the same runs. Branch-aware abort compresses storage to $M_{\mathrm  {spine}}$ ($0.70\times $, $0.61\times $, $0.94\times $ APC) at stable latency.}}{7}{figure.caption.14}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces GSM8K, $n{=}4$. FS/APC peak ${=}0.70$; FS/recompute ${=}0.25$: branch-aware sharing is storage-efficient at both $\mathrm  {tp}{=}2$ and $\mathrm  {tp}{=}4$. End-to-end vs.\ APC is $-0.3\%$ at $\mathrm  {tp}{=}2$ and $-0.4\%$ at $\mathrm  {tp}{=}4$.}}{7}{table.caption.15}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {10}DeepSeek-R1 8B math suite (settings I and J)}{7}{section.10}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {10.1}Accuracy comparison}{7}{subsection.10.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {10.2}System metrics}{7}{subsection.10.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {11}Cross-model summary}{7}{section.11}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {12}ForkServe+ concurrency (setting K)}{7}{section.12}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Game24, $n{=}4$. FS/APC peak ${=}0.61$; FS/recompute ${=}0.26$. A short trunk raises the unused-residual share, so storage-efficient abort saves more versus APC than on GSM8K. End-to-end vs.\ APC is $-0.7\%$ at $\mathrm  {tp}{=}2$ and $-2.0\%$ at $\mathrm  {tp}{=}4$. Success matches on all four problems.}}{8}{table.caption.16}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces HumanEval, $n{=}4$. FS/APC peak ${=}0.94$; FS/recompute ${=}0.49$. ReAct $k{=}2$ with a long observation suffix leaves less unused KV, so the storage gap versus APC is smaller, as \eqref  {eq:gap} predicts. TTFT vs.\ APC is $+0.1\%$ at $\mathrm  {tp}{=}2$ and $+0.4\%$ at $\mathrm  {tp}{=}4$. Pass@1 matches APC ($3/4$).}}{8}{table.caption.17}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {13}Prefill methods (setting L)}{8}{section.13}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {14}Discussion}{8}{section.14}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {15}Conclusion}{8}{section.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Setting C ($\mathrm  {tp}{=}4$): Game24 and HumanEval. $\mathrm  {peak}^{\mathrm  {FS}}/\mathrm  {peak}^{\mathrm  {APC}}$ is $0.61$ and $0.94$, as in setting B. Those storage ratios are fixed by $k$ and the residuals after abort (\eqref  {eq:gap}). Four-way tensor parallel shards the same committed path, so the HBM advantage versus APC is a property of branch-aware sharing and applies at $\mathrm  {tp}{=}4$.}}{9}{figure.caption.18}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces From $\mathrm  {tp}{=}2$ to $\mathrm  {tp}{=}4$, ForkServe latency (TTFT on HumanEval) scales by $0.61$--$0.63$, in line with decode on twice as many ranks. Peak is the committed-path length $M_{\mathrm  {spine}}$, so the storage ratio to APC is already set by abort in setting B. Four-GPU decode therefore stacks with that storage efficiency: each tree occupies less cache than APC, and $C\propto \mathrm  {HBM}/M$ is larger.}}{9}{table.caption.19}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Qwen3-14B official accuracy, APC vs.\ ForkServe. The pool is $513$ items. At two GPUs ForkServe is $+3$ problems; at four GPUs $-7$. No file differs by more than five problems. AIME remains $2$--$3/73$ on both stacks.}}{9}{table.caption.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Qwen3-14B accuracy, four stacks on each file. Orange tracks blue; the largest gaps are MATH-500 and GSM-Hard at $\mathrm  {tp}{=}4$ (five problems).}}{9}{figure.caption.21}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces Qwen3-14B storage and generate time. Peak KV equals the 8B suite and is independent of $\mathrm  {tp}$. Wall-clock is within $3\%$ of APC except SVAMP at two GPUs ($-5.3\%$), where ForkServe emits fewer winner tokens.}}{10}{table.caption.22}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Qwen3-14B fan-out and winner decode tokens. Fan-out is $1.2$--$1.9\times $ APC and still $<3\%$ of $T_{\mathrm  {e2e}}$. APC always spends the decode budget; ForkServe stops early on GSM8K and SVAMP.}}{10}{table.caption.23}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Qwen3-14B tensor-parallel scaling (ForkServe). Four ranks cut wall-clock by $0.61$--$0.64$, in line with setting C on the same weights. Peak is unchanged. Decode share of e2e is $0.98$--$0.99$.}}{10}{table.caption.24}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Qwen3-14B peak KV, shared by settings G and H. The bars equal the 8B figure: storage is $M_{\mathrm  {spine}}$, not model width.}}{11}{figure.caption.25}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Qwen3-14B end-to-end generate time. Orange sits on blue in each tensor-width pair. Light bars ($\mathrm  {tp}{=}4$) are $0.61$--$0.64\times $ the dark bars.}}{11}{figure.caption.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Qwen3-14B fan-out. The abort/CoW tax is larger in milliseconds than on 8B, but still tenths of a second against $34$--$111\,\mathrm  {s}$ generate.}}{11}{figure.caption.27}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces Official accuracy, APC vs.\ ForkServe, $\mathrm  {tp}{=}2$ and $\mathrm  {tp}{=}4$. Parentheses are correct counts. The last row is micro-average over the union of the seven files ($5{\times }80+73+40{=}513$). At two GPUs ForkServe is ahead on six files and on the pool ($+9$ problems). At four GPUs the pool is within seven problems; no file differs by more than three.}}{11}{table.caption.28}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Accuracy, four stacks on each file. Dark bars are $\mathrm  {tp}{=}2$, light bars $\mathrm  {tp}{=}4$. ForkServe (orange) tracks APC (blue) across both widths; AIME is near zero on all four.}}{12}{figure.caption.29}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces Storage and generate time. Peak KV is the same at $\mathrm  {tp}{=}2$ and $\mathrm  {tp}{=}4$. ForkServe is below APC on every file ($0.62$--$0.80\times $). Wall-clock stays within $3\%$ of APC except GSM8K at four GPUs ($-6.1\%$), where the winner stops early.}}{12}{table.caption.30}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {21}{\ignorespaces Fan-out work and winner decode tokens. ForkServe pays abort and copy-on-write, so fan-out is $1.2$--$1.9\times $ APC; that step is still $<4\%$ of $T_{\mathrm  {e2e}}$. APC always emits the decode budget; ForkServe stops early on GSM8K and SVAMP, which is why those files can be slightly faster at matched $W$.}}{12}{table.caption.31}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces Tensor-parallel scaling and decode share of e2e (ForkServe, $\mathrm  {tp}{=}2$). Four ranks cut wall-clock by $0.66$ on every file, matching APC's own $4/2$ ratio. Peak is unchanged. Decode dominates, so the fan-out tax does not set $T_{\mathrm  {e2e}}$.}}{13}{table.caption.32}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Peak KV, shared by settings E and F. Every file is below APC. Game24 is the largest abort gap ($0.62\times $); AIME the smallest ($0.80\times $), still $20\%$ below the hashed union.}}{13}{figure.caption.33}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces End-to-end generate time. Orange sits on blue in each tensor-width pair. Light bars ($\mathrm  {tp}{=}4$) are $0.66\times $ the dark bars; latency follows decode on more ranks, not a change in $M$.}}{13}{figure.caption.34}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Fan-out (branch prefill plus abort). ForkServe is higher at matched $W{=}L+k\bar  \ell $ because of copy-on-write and abort. The gap is tenths of a second against $22$--$67\,\mathrm  {s}$ generate, so it does not move the accuracy or e2e comparison.}}{13}{figure.caption.35}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces DeepSeek-R1 8B accuracy, four stacks on each file. Orange tracks blue; ForkServe is ahead or tied on six of seven files at $\mathrm  {tp}{=}2$ and on five at $\mathrm  {tp}{=}4$. Game24 is near zero on all four.}}{13}{figure.caption.37}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {23}{\ignorespaces DeepSeek-R1-Distill-Llama-8B official accuracy, APC vs.\ ForkServe. The pool is the same $513$ items as E--H. At two GPUs ForkServe is $+10$ problems; at four GPUs $+11$. GSM-Hard at $\mathrm  {tp}{=}2$ and MATH-500 at $\mathrm  {tp}{=}4$ are the largest gains ($+6$ and $+9$). Game24 stays near floor on both stacks: R1 long CoT rarely emits a clean four-card expression.}}{14}{table.caption.36}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {24}{\ignorespaces DeepSeek-R1 8B storage and generate time. Peak KV is the same at $\mathrm  {tp}{=}2$ and $\mathrm  {tp}{=}4$. ForkServe is below APC on every file ($0.58$--$0.77\times $). Pooled e2e is $1041$ vs.\ $1046\,\mathrm  {s}$ at two GPUs ($-0.5\%$) and $644$ vs.\ $636\,\mathrm  {s}$ at four GPUs ($+1.3\%$). SVAMP and GSM8K at $\mathrm  {tp}{=}4$ move with winner length, not fan-out.}}{14}{table.caption.38}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {25}{\ignorespaces DeepSeek-R1 8B fan-out and winner decode tokens. Fan-out is $1.2$--$1.7\times $ APC and still $<1\%$ of $T_{\mathrm  {e2e}}$ ($4.0$ vs.\ $6.0\,\mathrm  {s}$ summed at $\mathrm  {tp}{=}2$). APC always records the decode budget; ForkServe stops early except on AIME ($\approx 1990$ tokens/item).}}{14}{table.caption.39}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {26}{\ignorespaces DeepSeek-R1 8B tensor-parallel scaling (ForkServe). Four ranks cut wall-clock by $0.56$--$0.64$. Peak is unchanged. Decode share of e2e is $0.99$--$1.00$.}}{15}{table.caption.40}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces DeepSeek-R1 8B peak KV, shared by settings I and J. Every file is below APC. Game24 is the largest abort gap ($0.58\times $); AIME the smallest ($0.77\times $).}}{15}{figure.caption.41}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces DeepSeek-R1 8B end-to-end generate time. Light bars ($\mathrm  {tp}{=}4$) are $0.56$--$0.64\times $ the dark bars. Orange sits on blue except where winner length differs (GSM8K, SVAMP).}}{15}{figure.caption.42}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces DeepSeek-R1 8B fan-out. The abort/CoW tax is tenths of a second against $56$--$179\,\mathrm  {s}$ generate, so it does not set $T_{\mathrm  {e2e}}$.}}{15}{figure.caption.43}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {27}{\ignorespaces Micro-average accuracy and system summary on the $513$-item union. Storage ratios are unchanged by tensor width. Quality stays within a few problems of APC on Qwen and is ahead on DeepSeek-R1. Four-GPU wall-clock is $0.56$--$0.66\times $ two GPUs on every checkpoint.}}{15}{table.caption.44}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Pool accuracy across checkpoints. Orange sits on blue inside each model; the vertical gap between Qwen and R1 is the checkpoint and $D{=}2048$, not APC vs.\ ForkServe.}}{16}{figure.caption.45}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Storage ratio by file. Qwen3-8B and Qwen3-14B share the left bar. Every ratio is below $1$; Game24 is the largest abort gap on both families.}}{16}{figure.caption.46}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {28}{\ignorespaces Mock ToT micro-fan-out ($8$ sessions, $k{=}4$). Plus prunes two residuals before GPU prefill; peak KV is still the committed path.}}{16}{table.caption.47}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {29}{\ignorespaces Analytical QPS sweep from \eqref  {eq:conc} with GSM8K peaks $1563$ vs.\ $1163$. APC saturates at $37$ slots / $23680$ tok/s; ForkServe+ at $50$ / $32000$ tok/s ($+35\%$). Max QPS with P99 TTFT $\le 1\,\mathrm  {s}$ is $192$ (APC) vs.\ $256$ (ForkServe+).}}{16}{table.caption.48}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {30}{\ignorespaces Setting L, first fan-out. Control-plane cost model, not A100 wall-clock. APP prunes $20$ residuals across the ten sessions and ships $352$ tokens instead of the full clone.}}{16}{table.caption.51}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Setting K throughput. The two stacks match until the APC slot cap ($37$ trees). ForkServe+ continues to $50$ trees / $32000$ tok/s.}}{17}{figure.caption.49}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Setting K tail latency. APC crosses the $1\,\mathrm  {s}$ SLO between $192$ and $256$ QPS; ForkServe+ remains under the SLO at $256$.}}{17}{figure.caption.50}\protected@file@percent }
