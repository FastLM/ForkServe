\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Official GSM8K extractor, running accuracy. Tree-of-Thoughts accuracy ($\approx 0.845$) is below single-path generation ($\approx 0.941$) because several thoughts compete. The committed path after abort is the same winner decode as APC, so scores stay aligned.}}{6}{figure.caption.11}\protected@file@percent }
\newlabel{fig:acc}{{3}{6}{Official GSM8K extractor, running accuracy. Tree-of-Thoughts accuracy ($\approx 0.845$) is below single-path generation ($\approx 0.941$) because several thoughts compete. The committed path after abort is the same winner decode as APC, so scores stay aligned}{figure.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Generate time on full GSM8K. Decode of $D{=}512$ sets the global $T_{\mathrm  {e2e}}$; ForkServe stays with APC while $M$ is lower, which is storage-efficient serving in \eqref  {eq:conc}.}}{6}{table.caption.13}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8}Qwen3-14B math suite (settings G and H)}{6}{section.8}\protected@file@percent }
