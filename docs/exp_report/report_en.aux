\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces DeepSeek-R1 8B accuracy, four stacks on each file. Orange tracks blue; ForkServe is ahead or tied on six of seven files at $\mathrm  {tp}{=}2$ and on five at $\mathrm  {tp}{=}4$. Game24 is near zero on all four.}}{24}{figure.caption.38}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {24}{\ignorespaces DeepSeek-R1 8B storage and generate time. Peak KV is the same at $\mathrm  {tp}{=}2$ and $\mathrm  {tp}{=}4$. ForkServe is below APC on every file ($0.58$--$0.77\times $). Pooled e2e is $1041$ vs.\ $1046\,\mathrm  {s}$ at two GPUs ($-0.5\%$) and $644$ vs.\ $636\,\mathrm  {s}$ at four GPUs ($+1.3\%$). SVAMP and GSM8K at $\mathrm  {tp}{=}4$ move with winner length, not fan-out.}}{24}{table.caption.39}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {25}{\ignorespaces DeepSeek-R1 8B fan-out and winner decode tokens. Fan-out is $1.2$--$1.7\times $ APC and still $<1\%$ of $T_{\mathrm  {e2e}}$ ($4.0$ vs.\ $6.0\,\mathrm  {s}$ summed at $\mathrm  {tp}{=}2$). APC always records the decode budget; ForkServe stops early except on AIME ($\approx 1990$ tokens/item).}}{25}{table.caption.40}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {26}{\ignorespaces DeepSeek-R1 8B tensor-parallel scaling (ForkServe). Four ranks cut wall-clock by $0.56$--$0.64$. Peak is unchanged. Decode share of e2e is $0.99$--$1.00$.}}{25}{table.caption.41}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces DeepSeek-R1 8B peak KV, shared by settings I and J. Every file is below APC. Game24 is the largest abort gap ($0.58\times $); AIME the smallest ($0.77\times $).}}{26}{figure.caption.42}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces DeepSeek-R1 8B end-to-end generate time. Light bars ($\mathrm  {tp}{=}4$) are $0.56$--$0.64\times $ the dark bars. Orange sits on blue except where winner length differs (GSM8K, SVAMP).}}{26}{figure.caption.43}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces DeepSeek-R1 8B fan-out. The abort/CoW tax is tenths of a second against $56$--$179\,\mathrm  {s}$ generate, so it does not set $T_{\mathrm  {e2e}}$.}}{26}{figure.caption.44}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {27}{\ignorespaces Micro-average accuracy and system summary on the $513$-item union. Storage ratios are unchanged by tensor width. Quality stays within a few problems of APC on Qwen and is ahead on DeepSeek-R1. Four-GPU wall-clock is $0.56$--$0.66\times $ two GPUs on every checkpoint.}}{26}{table.caption.45}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Pool accuracy across checkpoints. Orange sits on blue inside each model; the vertical gap between Qwen and R1 is the checkpoint and $D{=}2048$, not APC vs.\ ForkServe.}}{27}{figure.caption.46}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Storage ratio by file. Qwen3-8B and Qwen3-14B share the left bar. Every ratio is below $1$; Game24 is the largest abort gap on both families.}}{27}{figure.caption.47}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {28}{\ignorespaces Mock ToT micro-fan-out ($8$ sessions, $k{=}4$). Plus prunes two residuals before GPU prefill; peak KV is still the committed path.}}{27}{table.caption.48}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {29}{\ignorespaces Analytical QPS sweep from \eqref  {eq:conc} with GSM8K peaks $1563$ vs.\ $1163$. APC saturates at $37$ slots / $23680$ tok/s; ForkServe+ at $50$ / $32000$ tok/s ($+35\%$). Max QPS with P99 TTFT $\le 1\,\mathrm  {s}$ is $192$ (APC) vs.\ $256$ (ForkServe+).}}{27}{table.caption.49}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {30}{\ignorespaces Setting L, first fan-out. Control-plane cost model, not A100 wall-clock. APP prunes $20$ residuals across the ten sessions and ships $352$ tokens instead of the full clone.}}{27}{table.caption.52}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Setting K throughput. The two stacks match until the APC slot cap ($37$ trees). ForkServe+ continues to $50$ trees / $32000$ tok/s.}}{28}{figure.caption.50}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Setting K tail latency. APC crosses the $1\,\mathrm  {s}$ SLO between $192$ and $256$ QPS; ForkServe+ remains under the SLO at $256$.}}{28}{figure.caption.51}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces Setting L visualization. Hash prefill matches APC on the first expand. Stock disaggregated prefill is slower because it ships the clone. ForkServe aliases the trunk; APP also drops the two low-score residuals.}}{28}{figure.caption.53}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {31}{\ignorespaces Setting M, GSM8K prefix $n{=}80$, $D{=}512$. Peak KV is identical at $\mathrm  {tp}{=}2$ and $\mathrm  {tp}{=}4$: occupancy tracks the committed spine, not the rank count. ForkServe+ / APC peak $=1182/1582{=}0.75$. Decode tokens follow \eqref  {eq:dec-stop}: APC always spends $nD$; ForkServe already hits EOS ($0.52\times $); the stop list cuts that to $0.33\times $ and e2e to $0.78\times $ APC at $\mathrm  {tp}{=}2$ and $0.75\times $ at $\mathrm  {tp}{=}4$. Accuracy at four GPUs is $74/80$ vs.\ APC $75/80$.}}{29}{table.caption.54}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces Setting M, GSM8K. Hatched bars are $\mathrm  {tp}{=}4$. APC spends the full $nD$ budget; ForkServe already stops on EOS; ForkServe+ stops at \texttt  {\#\#\#\#}. End-to-end follows $D^{+}$, not fan-out.}}{29}{figure.caption.55}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces Setting M storage vs.\ latency. Left: peak KV is identical for ForkServe and ForkServe+, below APC on ToT ($0.75\times $, $0.62\times $) and close on ReAct ($0.96\times $). Right: at $\mathrm  {tp}{=}4$, only GSM8K e2e drops, because Game24 and HumanEval do not hit the stop list.}}{29}{figure.caption.56}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {32}{\ignorespaces Setting M, Game24 and HumanEval, $n{=}80$. Peak ratios vs.\ APC: Game24 $793/1289{=}0.62$, HumanEval $1882/1970{=}0.96$ (wrap-dominated, $k{=}2$), matching \eqref  {eq:gap}. Decode tokens barely move, so e2e stays within $1\%$ of APC. Game24 success under ForkServe+ is lower than ForkServe at both widths; HumanEval pass@1 is matched at $\mathrm  {tp}{=}2$ and $-3$ problems at $\mathrm  {tp}{=}4$.}}{30}{table.caption.57}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {33}{\ignorespaces Setting N, GSM8K $n{=}40$, $\mathrm  {tp}{=}2$. Peak KV is $0.72$--$0.75\times $ APC on every family and does not change at $\mathrm  {tp}{=}4$. ForkServe accuracy stays with APC ($\pm 2$ problems except Math-1.5B, where both are weak). ForkServe+ stop is safe on Llama-3-8B and cuts tokens on Qwen without always matching accuracy.}}{30}{table.caption.58}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces Setting N peak-KV ratio vs.\ APC. GSM8K sits in $[0.72,0.75]$; Game24 in $[0.57,0.62]$. The abort gap of \eqref  {eq:gap} is a property of $k$ and residual length, not of the weight family.}}{30}{figure.caption.59}\protected@file@percent }
