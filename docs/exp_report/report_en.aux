\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Peak resident KV tokens, GSM8K, $165$ batches of eight problems. Storage efficiency versus recompute is $1-\mathrm  {med}(\mathrm  {peak})/\mathrm  {med}(\mathrm  {peak}^{\mathrm  {rec}})$ on the median.}}{9}{table.caption.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Left: peak KV on each of the $165$ GSM8K batches in the run log (eight problems per batch). Branch-aware abort keeps ForkServe below APC on every batch. Right: ratio $\mathrm  {peak}^{\mathrm  {FS}}/\mathrm  {peak}^{\mathrm  {APC}}$, median $0.72$: $28\%$ less cache than hashed prefix reuse.}}{9}{figure.caption.8}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces GSM8K, $n{=}1319$, $k{=}4$, $\mathrm  {tp}{=}2$, eight problems per batch. Storage (peak KV) is the ForkServe gain; accuracy and generate time stay with APC.}}{9}{table.caption.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Left: the storage gap versus APC is a shift of the whole distribution. Right: median peak KV, $0.25\times $ recompute and $0.72\times $ APC.}}{10}{figure.caption.9}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Storage savings against both vLLM baselines. $S_{\mathrm  {APC}}{=}1-\mathrm  {med}(\mathrm  {peak}^{\mathrm  {FS}})/\mathrm  {med}(\mathrm  {peak}^{\mathrm  {APC}})$. APC already removed most of the cloned-trunk cost ($1430$ vs.\ $4136$). The extra $28\%$ is branch-aware abort: hashed union versus committed path.}}{10}{table.caption.11}\protected@file@percent }
