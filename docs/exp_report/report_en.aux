\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Qwen3-14B tensor-parallel scaling (ForkServe). Four ranks cut wall-clock by $0.61$--$0.64$, in line with setting C on the same weights. Peak is unchanged. Decode share of e2e is $0.98$--$0.99$.}}{17}{table.caption.25}\protected@file@percent }
