\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Accuracy, four stacks on each file. Dark bars are $\mathrm  {tp}{=}2$, light bars $\mathrm  {tp}{=}4$. ForkServe (orange) tracks APC (blue) across both widths; AIME is near zero on all four.}}{20}{figure.caption.30}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces Storage and generate time. Peak KV is the same at $\mathrm  {tp}{=}2$ and $\mathrm  {tp}{=}4$. ForkServe is below APC on every file ($0.62$--$0.80\times $). Wall-clock stays within $3\%$ of APC except GSM8K at four GPUs ($-6.1\%$), where the winner stops early.}}{20}{table.caption.31}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {17}Six-model GPU forest (setting N)}{20}{section.17}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {17.1}Peak KV holds across families}{20}{subsection.17.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {17.2}Decode stop is not portable}{20}{subsection.17.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {21}{\ignorespaces Fan-out work and winner decode tokens. ForkServe pays abort and copy-on-write, so fan-out is $1.2$--$1.9\times $ APC; that step is still $<4\%$ of $T_{\mathrm  {e2e}}$. APC always emits the decode budget; ForkServe stops early on GSM8K and SVAMP, which is why those files can be slightly faster at matched $W$.}}{21}{table.caption.32}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces Tensor-parallel scaling and decode share of e2e (ForkServe, $\mathrm  {tp}{=}2$). Four ranks cut wall-clock by $0.66$ on every file, matching APC's own $4/2$ ratio. Peak is unchanged. Decode dominates, so the fan-out tax does not set $T_{\mathrm  {e2e}}$.}}{21}{table.caption.33}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {17.3}Last-line answer stop}{21}{subsection.17.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {18}Discussion}{21}{section.18}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Peak KV, shared by settings E and F. Every file is below APC. Game24 is the largest abort gap ($0.62\times $); AIME the smallest ($0.80\times $), still $20\%$ below the hashed union.}}{22}{figure.caption.34}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces End-to-end generate time. Orange sits on blue in each tensor-width pair. Light bars ($\mathrm  {tp}{=}4$) are $0.66\times $ the dark bars; latency follows decode on more ranks, not a change in $M$.}}{22}{figure.caption.35}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Fan-out (branch prefill plus abort). ForkServe is higher at matched $W{=}L+k\bar  \ell $ because of copy-on-write and abort. The gap is tenths of a second against $22$--$67\,\mathrm  {s}$ generate, so it does not move the accuracy or e2e comparison.}}{23}{figure.caption.36}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {23}{\ignorespaces DeepSeek-R1-Distill-Llama-8B official accuracy, APC vs.\ ForkServe. The pool is the same $513$ items as E--H. At two GPUs ForkServe is $+10$ problems; at four GPUs $+11$. GSM-Hard at $\mathrm  {tp}{=}2$ and MATH-500 at $\mathrm  {tp}{=}4$ are the largest gains ($+6$ and $+9$). Game24 stays near floor on both stacks: R1 long CoT rarely emits a clean four-card expression.}}{23}{table.caption.37}\protected@file@percent }
